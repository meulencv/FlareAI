{
  "name": "faro-webcams-espana",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --use-system-ca --import tsx server/index.ts",
    "dev:ui": "vite",
    "start": "node --use-system-ca --import tsx server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --use-system-ca --import tsx --test tests/*.test.ts",
    "sync": "node --use-system-ca --import tsx server/sync.ts"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "express": "5.1.0",
    "fast-xml-parser": "5.11.1",
    "leaflet": "1.9.4",
    "supercluster": "8.0.1",
    "tsx": "4.20.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/express": "5.0.3",
    "@types/leaflet": "1.9.20",
    "@types/node": "24.3.0",
    "@types/supercluster": "7.1.3",
    "eslint": "9.34.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "6.4.3"
  }
}
